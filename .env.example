# Port for backend
PORT=5050

# Database URL used inside Docker Compose network
DATABASE_URL=postgresql://postgres:postgrespassword@postgres:5432/event_finder?schema=public

# Secret for signing JWT authentication tokens
JWT_SECRET=supersecretjwtkeyforlocaldevelopment123

# Gemini API Key for AI Assistant & Embeddings (optional, from https://aistudio.google.com/)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Optional Ticketmaster API key
TICKETMASTER_API_KEY=

# In-memory sample events fallback
USE_SAMPLE_EVENTS=true

# Allowed client origin
CLIENT_ORIGIN=http://localhost:5173
